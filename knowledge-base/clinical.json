      ],
      "stage": "assessment",
      "say": "Check whether the person responds when you speak loudly and gently tap them.",
      "sources": [
        "redcross_cpr_steps",
        "aha_pediatric_2025"
      ],
      "approval": "draft_not_for_emergency_use",
